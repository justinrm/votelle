*.onnx
*.bin
*.pkl

.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/
.eggs/

/cache/
/runs/
/checkpoints/
/dist/
*.log
wandb/
mlruns/
lightning_logs/
